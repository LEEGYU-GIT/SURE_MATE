{
  "format": "sure-mate-glossary",
  "version": 1,
  "exportedAt": "2026-11-09T00:00:00.000Z",
  "entries": [
    { "id": "code-coverage", "term": "코드 커버리지", "aliases": ["커버리지", "Code Coverage", "시험 커버리지"], "definition": "시험이 코드의 어느 부분을 실행했는지를 비율로 나타낸 값. 구문·분기·조건·MC/DC처럼 무엇을 셀지에 따라 기준이 나뉜다. 높다고 결함이 없다는 뜻은 아니며, 요구사항 기반 시험이 코드를 충분히 실행했는지 확인하는 데 쓴다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "statement-coverage", "term": "구문 커버리지", "aliases": ["Statement Coverage", "문장 커버리지", "명령문 커버리지"], "definition": "실행할 수 있는 문장 가운데 시험에서 한 번 이상 실행된 문장의 비율. 가장 약한 커버리지 기준으로, 분기의 한쪽만 실행해도 채워질 수 있다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "branch-coverage", "term": "분기 커버리지", "aliases": ["Branch Coverage", "결정 커버리지", "Decision Coverage"], "definition": "모든 분기(if·switch·반복문의 결정)가 참과 거짓 쪽으로 각각 한 번 이상 실행됐는지 보는 커버리지. 구문 커버리지보다 강한 기준이다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "condition-coverage", "term": "조건 커버리지", "aliases": ["Condition Coverage"], "definition": "결정 안의 개별 조건(예: A && B의 A와 B)이 각각 참과 거짓을 모두 가졌는지 보는 커버리지. 결정 전체의 결과는 따지지 않아 분기 커버리지를 보장하지 않는다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "mcdc", "term": "MC/DC", "aliases": ["MCDC", "Modified Condition/Decision Coverage", "변경 조건/결정 커버리지"], "definition": "결정 안의 각 조건이, 다른 조건은 그대로 둔 채 혼자서 결정 결과를 바꾸는 경우를 시험으로 보이는 커버리지. 조건이 N개면 보통 N+1개 시험으로 채울 수 있다. DO-178C 레벨 A와 ISO 26262 ASIL D 단위 시험에서 요구하거나 강하게 권장한다.", "example": "if (A && B)라면 A만 바꿔 결과가 바뀌는 시험 쌍과 B만 바꿔 결과가 바뀌는 시험 쌍이 모두 있어야 한다.", "links": [], "tags": ["커버리지", "기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "function-coverage", "term": "함수 커버리지", "aliases": ["Function Coverage"], "definition": "프로그램의 함수 가운데 시험에서 한 번 이상 호출된 함수의 비율. ISO 26262 소프트웨어 통합 시험의 구조 커버리지 기준 가운데 하나다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "call-coverage", "term": "호출 커버리지", "aliases": ["Call Coverage", "함수 호출 커버리지"], "definition": "코드 안의 함수 호출 지점 가운데 시험에서 실행된 지점의 비율. 함수 커버리지와 함께 통합 시험이 충분한지 판단하는 데 쓴다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "path-coverage", "term": "경로 커버리지", "aliases": ["Path Coverage"], "definition": "프로그램의 가능한 실행 경로 가운데 시험으로 지나간 경로의 비율. 반복문이 있으면 경로 수가 매우 많아져 실무에서는 일부 경로만 본다.", "links": [], "tags": ["커버리지"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "structural-coverage-analysis", "term": "구조 커버리지 분석", "aliases": ["Structural Coverage Analysis"], "definition": "요구사항 기반 시험이 코드 구조를 얼마나 실행했는지 재서, 시험되지 않은 코드(요구사항 누락, 죽은 코드, 시험 부족)를 찾아내는 활동. DO-178C가 요구한다.", "links": [], "tags": ["커버리지", "항공"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "unit-test", "term": "단위 시험", "aliases": ["Unit Test", "단위 테스트", "유닛 테스트", "UT"], "definition": "함수나 모듈처럼 가장 작은 단위를 다른 부분과 떼어 시험하는 것. 부르는 쪽은 드라이버, 불리는 쪽은 스텁으로 대신한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "integration-test", "term": "통합 시험", "aliases": ["Integration Test", "통합 테스트"], "definition": "단위 시험을 마친 모듈을 합쳐 모듈 사이의 인터페이스와 상호 작용이 맞는지 확인하는 시험.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "system-test", "term": "시스템 시험", "aliases": ["System Test", "시스템 테스트"], "definition": "완성된 시스템 전체가 시스템 요구사항을 만족하는지 실제와 가까운 환경에서 확인하는 시험.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "acceptance-test", "term": "인수 시험", "aliases": ["Acceptance Test", "인수 테스트", "UAT"], "definition": "발주자나 사용자가 시스템을 받아들일지 판단하려고 하는 시험.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "regression-test", "term": "회귀 시험", "aliases": ["Regression Test", "회귀 테스트"], "definition": "코드를 고친 뒤 전에 되던 기능이 여전히 되는지 다시 하는 시험. 자동화해 두면 고칠 때마다 돌릴 수 있다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "smoke-test", "term": "스모크 시험", "aliases": ["Smoke Test", "스모크 테스트"], "definition": "새 빌드에서 핵심 기능이 기본적으로 동작하는지 빠르게 보는 얕은 시험. 이것을 통과해야 본격적인 시험을 시작한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "black-box-test", "term": "블랙박스 시험", "aliases": ["Black-box Test", "블랙박스 테스트", "명세 기반 시험"], "definition": "내부 구조를 보지 않고 요구사항·명세만 보고 입력과 기대 결과를 정하는 시험. 동등 분할, 경계값 분석, 결정 테이블 같은 기법이 있다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "white-box-test", "term": "화이트박스 시험", "aliases": ["White-box Test", "화이트박스 테스트", "구조 기반 시험"], "definition": "코드의 내부 구조(분기, 경로)를 보고 시험을 설계하는 방식. 충분한지는 커버리지로 잰다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "test-case", "term": "테스트 케이스", "aliases": ["Test Case", "TC", "시험 케이스", "시험 항목"], "definition": "입력, 실행 조건, 절차, 기대 결과를 묶은 시험 하나. 어떤 요구사항을 확인하는지 요구사항 ID로 연결해 둔다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "test-oracle", "term": "테스트 오라클", "aliases": ["Test Oracle"], "definition": "시험 결과가 맞는지 판단하는 기준이나 방법. 명세에서 계산한 기대 결과, 이전 버전의 결과, 다른 구현의 결과 등이 쓰인다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "boundary-value-analysis", "term": "경계값 분석", "aliases": ["Boundary Value Analysis", "BVA", "경계값 시험"], "definition": "입력 범위의 경계와 그 바로 안팎 값을 골라 시험하는 기법. 결함이 경계에서 자주 생긴다는 경험에 바탕을 둔다.", "example": "1~100을 받는 입력이면 0, 1, 2, 99, 100, 101을 시험한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "equivalence-partitioning", "term": "동등 분할", "aliases": ["Equivalence Partitioning", "동치 분할", "동등 클래스 분할"], "definition": "입력을 프로그램이 같게 처리할 것으로 보이는 무리(클래스)로 나누고, 무리마다 대표값으로 시험하는 기법. 유효한 무리와 무효한 무리를 모두 만든다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "decision-table-testing", "term": "결정 테이블 시험", "aliases": ["Decision Table Testing", "결정 테이블"], "definition": "조건의 조합과 그에 따른 동작을 표로 정리해, 조합마다 시험 케이스를 만드는 기법.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "state-transition-testing", "term": "상태 전이 시험", "aliases": ["State Transition Testing", "상태 전이 테스트"], "definition": "시스템의 상태와 사건에 따른 상태 바뀜을 모델로 그려, 올바른 전이와 잘못된 전이를 시험하는 기법.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "requirements-based-testing", "term": "요구사항 기반 시험", "aliases": ["Requirements-based Testing", "RBT"], "definition": "각 요구사항에서 시험 케이스를 끌어내 요구사항이 구현됐는지 확인하는 시험. 안전 규격은 요구사항 기반 시험과 그 커버리지 분석을 함께 요구한다.", "links": [], "tags": ["시험", "기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "fault-injection", "term": "결함 주입 시험", "aliases": ["Fault Injection", "고장 주입", "결함 주입"], "definition": "일부러 결함이나 고장(잘못된 값, 통신 끊김 등)을 넣어 시스템이 안전하게 대응하는지 보는 시험. ISO 26262에서 안전 메커니즘을 검증하는 데 쓴다.", "links": [], "tags": ["시험", "기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "stub", "term": "스텁", "aliases": ["Stub"], "definition": "시험 대상이 부르는 하위 함수나 모듈을 대신하는 단순한 가짜 코드. 정해 둔 값을 돌려줘 시험 대상만 따로 실행할 수 있게 한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "test-driver", "term": "테스트 드라이버", "aliases": ["Test Driver", "시험 드라이버"], "definition": "시험 대상을 불러 입력을 넣고 결과를 받아 확인하는 코드. 단위 시험에서 상위 모듈을 대신한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "mock", "term": "목 객체", "aliases": ["Mock", "모의 객체"], "definition": "시험에서 실제 객체 대신 쓰는 가짜 객체. 돌려줄 값뿐 아니라 어떻게 호출됐는지(횟수, 인자)까지 확인한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "test-harness", "term": "테스트 하네스", "aliases": ["Test Harness", "시험 하네스"], "definition": "드라이버, 스텁, 시험 데이터, 실행·판정 도구를 묶어 시험을 자동으로 돌리는 환경.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "hils", "term": "HILS", "aliases": ["HIL", "Hardware-in-the-Loop", "하드웨어 인 더 루프"], "definition": "실제 제어기(ECU) 하드웨어를 실시간 시뮬레이터에 연결해, 차량이나 설비 대신 가상의 환경과 신호를 주고받으며 시험하는 방식.", "links": [], "tags": ["시험", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sil-software", "term": "SIL", "aliases": ["SILS", "Software-in-the-Loop", "소프트웨어 인 더 루프"], "definition": "실제 하드웨어 없이 PC에서 제어 소프트웨어를 대상 시스템 모델과 함께 돌려 시험하는 방식. 안전 무결성 수준을 뜻하는 SIL(Safety Integrity Level)과 다르다.", "links": [], "tags": ["시험", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "mil", "term": "MIL", "aliases": ["MILS", "Model-in-the-Loop", "모델 인 더 루프"], "definition": "제어 알고리즘을 코드로 만들기 전에 모델(예: Simulink) 상태로 대상 시스템 모델과 함께 시뮬레이션해 시험하는 단계.", "links": [], "tags": ["시험", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "pil", "term": "PIL", "aliases": ["PILS", "Processor-in-the-Loop", "프로세서 인 더 루프"], "definition": "생성한 코드를 실제 대상 프로세서(또는 평가 보드)에서 돌리고 대상 시스템 모델은 PC에서 돌려, 컴파일러와 프로세서의 영향을 확인하는 시험.", "links": [], "tags": ["시험", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "back-to-back-test", "term": "백투백 시험", "aliases": ["Back-to-Back Test", "B2B 시험", "등가성 시험"], "definition": "같은 입력을 모델과 생성 코드(또는 두 버전)에 넣어 결과가 같은지 비교하는 시험. 모델 기반 개발에서 코드 생성이 맞게 됐는지 확인한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "mutation-testing", "term": "뮤테이션 시험", "aliases": ["Mutation Testing", "변이 시험"], "definition": "코드를 조금씩 바꾼 변이체를 만들고 기존 시험이 그 변화를 잡아내는지 보아, 시험이 결함을 얼마나 잘 찾는지 평가하는 기법.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "fuzzing", "term": "퍼징", "aliases": ["Fuzzing", "퍼즈 시험", "Fuzz Testing"], "definition": "무작위나 변형된 입력을 대량으로 넣어 비정상 종료, 메모리 오류 같은 결함과 보안 취약점을 찾는 시험.", "links": [], "tags": ["시험", "보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "penetration-test", "term": "모의 해킹", "aliases": ["Penetration Test", "침투 시험", "펜테스트"], "definition": "공격자 입장에서 시스템의 보안 취약점을 실제로 찾아 공격해 보는 시험.", "links": [], "tags": ["시험", "보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "test-automation", "term": "시험 자동화", "aliases": ["Test Automation", "테스트 자동화"], "definition": "시험 실행과 결과 판정을 도구와 스크립트로 자동으로 하는 것. 회귀 시험을 자주 돌릴 수 있게 한다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "static-analysis", "term": "정적분석", "aliases": ["Static Analysis", "정적 분석", "SA", "정적 시험"], "definition": "프로그램을 실행하지 않고 소스 코드나 바이너리를 분석해 결함, 코딩 규칙 위반, 보안 취약점, 복잡도 등을 찾는 것. 사람의 검토와 도구 분석이 모두 포함된다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "dynamic-analysis", "term": "동적분석", "aliases": ["Dynamic Analysis", "동적 분석"], "definition": "프로그램을 실제로 실행하면서 동작, 메모리 사용, 커버리지, 성능 등을 관찰해 결함을 찾는 것. 단위·통합 시험과 실행 중 메모리 검사 등이 있다.", "links": [], "tags": ["시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "coding-standard", "term": "코딩 규칙", "aliases": ["Coding Standard", "코딩 표준", "코딩 지침", "Coding Rule"], "definition": "결함을 줄이고 읽기 쉬운 코드를 쓰려고 정한 작성 규칙. MISRA C, CERT C, AUTOSAR C++14 지침 같은 공개 규칙이나 회사 자체 규칙을 쓴다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "misra-c", "term": "MISRA C", "aliases": ["MISRA", "MISRA-C", "미스라"], "definition": "MISRA가 만든 C 언어 코딩 지침. 정의되지 않은 동작과 위험한 구문을 피하도록 규칙을 필수(Mandatory)·요구(Required)·권고(Advisory)로 나눈다. 자동차에서 시작해 안전이 중요한 임베디드 소프트웨어 전반에서 쓴다.", "links": [], "tags": ["정적분석", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "misra-cpp", "term": "MISRA C++", "aliases": ["MISRA-C++", "MISRA C++:2023"], "definition": "MISRA가 만든 C++ 코딩 지침. 2023년판은 AUTOSAR C++14 지침의 내용을 받아들여 새로 정리했다.", "links": [], "tags": ["정적분석", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "autosar-cpp14", "term": "AUTOSAR C++14", "aliases": ["AUTOSAR C++14 지침", "AUTOSAR C++ Coding Guidelines"], "definition": "AUTOSAR가 안전 관련 C++14 코드를 위해 만든 코딩 지침. 이후 MISRA C++:2023으로 이어졌다.", "links": [], "tags": ["정적분석", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "cert-c", "term": "CERT C", "aliases": ["SEI CERT C", "CERT 코딩 표준"], "definition": "카네기멜런대 SEI가 만든 C 보안 코딩 표준. 취약점으로 이어지는 코딩 실수를 규칙과 권고로 정리했다. C++, 자바용도 있다.", "links": [], "tags": ["정적분석", "보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "cwe", "term": "CWE", "aliases": ["Common Weakness Enumeration", "약점 목록"], "definition": "MITRE가 관리하는 소프트웨어·하드웨어 약점 유형 목록. 정적분석 도구가 찾은 결함을 CWE 번호로 분류하곤 한다.", "links": [], "tags": ["보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "cve", "term": "CVE", "aliases": ["Common Vulnerabilities and Exposures", "취약점 번호"], "definition": "공개된 보안 취약점마다 붙이는 고유 번호(CVE-연도-번호) 체계. 특정 제품의 특정 취약점을 가리킨다.", "links": [], "tags": ["보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sast", "term": "SAST", "aliases": ["Static Application Security Testing", "정적 보안 시험"], "definition": "소스 코드나 바이너리를 실행하지 않고 분석해 보안 취약점을 찾는 시험. 실행 중인 프로그램을 공격해 보는 DAST와 짝을 이룬다.", "links": [], "tags": ["보안", "정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sca-composition", "term": "SCA", "aliases": ["Software Composition Analysis", "소프트웨어 구성 분석", "오픈소스 분석"], "definition": "제품에 들어간 오픈소스와 외부 구성 요소를 찾아 라이선스와 알려진 취약점(CVE)을 점검하는 것.", "links": [], "tags": ["보안", "오픈소스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "false-positive", "term": "오탐", "aliases": ["False Positive", "거짓 양성", "오경보"], "definition": "결함이 아닌데 도구가 결함이라고 알린 경우. 오탐이 많으면 검토 비용이 커지고 진짜 경고를 놓치기 쉽다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "false-negative", "term": "미탐", "aliases": ["False Negative", "거짓 음성"], "definition": "실제 결함이 있는데 도구가 알리지 못한 경우. 정적분석 결과가 깨끗해도 결함이 없다는 증명은 아니다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "deviation", "term": "위반 소명", "aliases": ["Deviation", "소명", "편차 승인", "Deviation Record"], "definition": "코딩 규칙 위반을 고치지 않고 두는 이유와 그래도 안전하다는 근거를 문서로 남기고 승인받는 것. MISRA Compliance에서는 deviation record라고 한다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "abstract-interpretation", "term": "요약 해석", "aliases": ["Abstract Interpretation", "추상 해석"], "definition": "프로그램이 가질 수 있는 모든 값을 범위 같은 요약된 형태로 계산하는 정적분석 기법. 0으로 나누기나 배열 범위 초과 같은 런타임 오류가 없음을 증명하는 데 쓴다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "runtime-error", "term": "런타임 오류", "aliases": ["Runtime Error", "실행 시간 오류"], "definition": "프로그램이 실행되는 동안 생기는 오류. 0으로 나누기, 배열 범위 초과, 널 포인터 역참조, 정수 오버플로, 초기화하지 않은 변수 읽기 등이 있다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "cyclomatic-complexity", "term": "순환 복잡도", "aliases": ["Cyclomatic Complexity", "McCabe 복잡도", "맥케이브 복잡도", "V(G)"], "definition": "함수 안의 독립적인 실행 경로 수를 나타내는 지표. 보통 결정(분기) 수에 1을 더한 값이며, 클수록 시험과 이해가 어렵다. 많은 조직이 10이나 20 같은 상한을 둔다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "code-metrics", "term": "코드 메트릭", "aliases": ["Code Metrics", "소프트웨어 메트릭", "코드 지표"], "definition": "코드의 크기, 복잡도, 결합도, 주석 비율 등을 숫자로 잰 지표. 품질 기준을 넘는 함수를 찾아 고치거나 검토하는 데 쓴다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "dead-code", "term": "죽은 코드", "aliases": ["Dead Code", "데드 코드"], "definition": "실행은 되지만 결과가 어디에도 쓰이지 않는 코드, 또는 요구사항과 연결되지 않은 코드. 규격마다 정의가 조금 다르며, 도달할 수 없는 코드와 구별해 쓰기도 한다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "unreachable-code", "term": "도달할 수 없는 코드", "aliases": ["Unreachable Code", "도달 불가 코드"], "definition": "어떤 입력으로도 실행될 수 없는 코드. 정적분석이나 커버리지 분석에서 드러나며, 지우거나 남기는 이유를 소명한다.", "links": [], "tags": ["정적분석"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "null-pointer-dereference", "term": "널 포인터 역참조", "aliases": ["Null Pointer Dereference", "NPD", "널 역참조"], "definition": "가리키는 곳이 없는(NULL) 포인터로 메모리를 읽거나 쓰는 오류. 프로그램이 죽거나 예측할 수 없게 동작한다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "buffer-overflow", "term": "버퍼 오버플로", "aliases": ["Buffer Overflow", "버퍼 넘침", "Buffer Overrun"], "definition": "정해진 크기의 메모리(버퍼) 밖을 쓰거나 읽는 오류. 데이터를 망가뜨리고 보안 공격에 악용될 수 있다.", "links": [], "tags": ["결함", "보안"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "integer-overflow", "term": "정수 오버플로", "aliases": ["Integer Overflow", "정수 넘침"], "definition": "정수 계산 결과가 자료형이 담을 수 있는 범위를 넘는 것. C에서 부호 있는 정수의 오버플로는 정의되지 않은 동작이다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "memory-leak", "term": "메모리 누수", "aliases": ["Memory Leak", "메모리 릭"], "definition": "할당한 메모리를 다 쓰고도 돌려주지 않아 쓸 수 있는 메모리가 점점 줄어드는 결함. 오래 켜 두는 임베디드 시스템에서 특히 위험하다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "race-condition", "term": "경쟁 상태", "aliases": ["Race Condition", "데이터 경쟁", "Data Race"], "definition": "여러 스레드나 인터럽트가 같은 데이터에 동시에 접근해, 실행 순서에 따라 결과가 달라지는 결함. 재현이 어려워 정적분석으로 찾기도 한다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "undefined-behavior", "term": "정의되지 않은 동작", "aliases": ["Undefined Behavior", "UB", "미정의 동작"], "definition": "언어 표준이 결과를 정하지 않은 동작. 컴파일러와 환경에 따라 결과가 달라져, 안전 관련 코딩 규칙은 이를 피하도록 한다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "stack-usage-analysis", "term": "스택 사용량 분석", "aliases": ["Stack Usage Analysis", "스택 오버플로", "Stack Overflow"], "definition": "함수 호출 깊이와 지역 변수로 쓰이는 스택의 최대 크기를 계산해 정해진 스택을 넘지 않는지 확인하는 것. 넘치면 다른 메모리를 덮어 알 수 없는 고장이 난다.", "links": [], "tags": ["임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "wcet", "term": "WCET", "aliases": ["Worst-Case Execution Time", "최악 실행 시간"], "definition": "코드가 실행되는 데 걸릴 수 있는 가장 긴 시간. 실시간 시스템이 마감 시간을 지키는지 판단하는 데 쓴다.", "links": [], "tags": ["임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "functional-safety", "term": "기능 안전", "aliases": ["Functional Safety"], "definition": "전기·전자 시스템이 고장 나도 사람에게 받아들일 수 없는 위험이 생기지 않도록 하는 것. 위험을 분석해 안전 목표를 정하고, 개발과 검증 활동으로 그 목표를 지킨다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iec-61508", "term": "IEC 61508", "aliases": ["IEC61508"], "definition": "전기·전자·프로그래머블 전자 안전 관련 시스템의 기능 안전 기본 표준. 안전 무결성 수준 SIL 1~4를 정하며, ISO 26262나 EN 50128 같은 산업별 표준의 바탕이 됐다.", "links": [], "tags": ["기능안전", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sil-safety", "term": "SIL", "aliases": ["Safety Integrity Level", "안전 무결성 수준"], "definition": "IEC 61508 계열 표준에서 안전 기능이 갖춰야 할 신뢰 수준. SIL 1~4이며 4가 가장 엄격하다. 소프트웨어를 PC에서 시험하는 방식인 SIL(Software-in-the-Loop)과 다르다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iso-26262", "term": "ISO 26262", "aliases": ["ISO26262", "자동차 기능 안전 표준"], "definition": "도로 차량 전기·전자 시스템의 기능 안전 국제 표준. 위험 분석으로 ASIL A~D를 정하고, 그 등급에 맞는 개발·검증 활동을 요구한다. 2018년에 2판이 나왔다.", "links": [], "tags": ["기능안전", "자동차", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "asil", "term": "ASIL", "aliases": ["Automotive Safety Integrity Level", "자동차 안전 무결성 수준"], "definition": "ISO 26262의 위험 등급. 심각도(S), 노출 빈도(E), 제어 가능성(C)으로 정하며 A가 가장 낮고 D가 가장 높다. 안전 요구가 없으면 QM이다.", "links": [], "tags": ["기능안전", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "qm", "term": "QM", "aliases": ["Quality Management"], "definition": "ISO 26262에서 ASIL이 필요 없는 위험 수준. 일반 품질 관리 절차만으로 충분하다는 뜻이다.", "links": [], "tags": ["기능안전", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "hara", "term": "HARA", "aliases": ["Hazard Analysis and Risk Assessment", "위험 분석 및 위험성 평가"], "definition": "ISO 26262 개념 단계에서 기능 고장으로 생길 수 있는 위험 상황을 찾고, 각각의 ASIL과 안전 목표를 정하는 활동.", "links": [], "tags": ["기능안전", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "safety-goal", "term": "안전 목표", "aliases": ["Safety Goal"], "definition": "HARA로 찾은 위험을 막으려고 정하는 최상위 안전 요구사항. ASIL을 함께 갖는다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "safety-mechanism", "term": "안전 메커니즘", "aliases": ["Safety Mechanism"], "definition": "고장을 찾아내거나 막아 시스템을 안전한 상태로 유지하는 기능. 워치독, 값 범위 점검, 이중화 비교 등이 있다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "fmea", "term": "FMEA", "aliases": ["Failure Mode and Effects Analysis", "고장 유형 및 영향 분석"], "definition": "부품이나 기능이 고장 나는 방식(고장 유형)을 하나씩 들어 그 영향과 원인, 대책을 표로 분석하는 기법. 아래에서 위로 분석한다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "fta", "term": "FTA", "aliases": ["Fault Tree Analysis", "결함 트리 분석", "고장 나무 분석"], "definition": "원하지 않는 최상위 사건에서 시작해 그 원인을 AND·OR 논리로 나무 모양으로 내려가며 분석하는 기법. 위에서 아래로 분석한다.", "links": [], "tags": ["기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iso-21448", "term": "ISO 21448", "aliases": ["SOTIF", "의도된 기능의 안전"], "definition": "의도된 기능의 안전(Safety of the Intended Functionality) 표준. 고장이 없어도 센서·알고리즘의 성능 한계나 예상할 수 있는 오사용 때문에 생기는 위험을 다룬다. 운전자 보조·자율주행 기능에서 중요하다.", "links": [], "tags": ["기능안전", "자동차", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iso-21434", "term": "ISO/SAE 21434", "aliases": ["ISO 21434", "자동차 사이버보안 표준"], "definition": "도로 차량 전기·전자 시스템의 사이버보안 공학 표준. 위협 분석과 위험성 평가(TARA)부터 개발, 운영, 폐기까지의 활동을 요구한다.", "links": [], "tags": ["보안", "자동차", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "tara", "term": "TARA", "aliases": ["Threat Analysis and Risk Assessment", "위협 분석 및 위험성 평가"], "definition": "ISO/SAE 21434에서 지킬 자산과 위협 시나리오를 찾고, 공격 가능성과 영향으로 위험을 평가해 대응 목표를 정하는 활동.", "links": [], "tags": ["보안", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "un-r155", "term": "UN R155", "aliases": ["R155", "CSMS", "자동차 사이버보안 법규"], "definition": "UNECE의 자동차 사이버보안 규정. 제조사가 사이버보안 관리 체계(CSMS)를 갖추고 차종별 인증을 받도록 한다.", "links": [], "tags": ["보안", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "un-r156", "term": "UN R156", "aliases": ["R156", "SUMS", "소프트웨어 업데이트 법규"], "definition": "UNECE의 자동차 소프트웨어 업데이트 규정. 소프트웨어 업데이트 관리 체계(SUMS)를 요구한다.", "links": [], "tags": ["자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "do-178c", "term": "DO-178C", "aliases": ["DO-178", "DO178C", "항공 소프트웨어 인증"], "definition": "항공기 탑재 소프트웨어 인증 지침(RTCA DO-178C, 유럽에서는 ED-12C). 고장 영향에 따라 레벨 A~E를 정하며, 레벨 A는 MC/DC 커버리지까지 요구한다.", "links": [], "tags": ["항공", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "dal", "term": "DAL", "aliases": ["Design Assurance Level", "설계 보증 수준", "개발 보증 수준"], "definition": "DO-178C(소프트웨어)와 DO-254(하드웨어)에서 고장이 항공기에 미치는 영향으로 정하는 레벨 A~E. A가 가장 엄격하다.", "links": [], "tags": ["항공"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "do-254", "term": "DO-254", "aliases": ["DO254", "항공 하드웨어 인증"], "definition": "항공기 탑재 전자 하드웨어(FPGA, ASIC 등)의 설계 보증 지침.", "links": [], "tags": ["항공", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "do-330", "term": "DO-330", "aliases": ["DO330", "도구 자격 지침"], "definition": "항공 분야에서 개발·검증 도구의 자격을 인정받는 방법을 정한 지침. 도구의 영향에 따라 TQL 1~5를 정한다.", "links": [], "tags": ["항공", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "en-50128", "term": "EN 50128", "aliases": ["EN50128", "철도 소프트웨어 표준", "EN 50716"], "definition": "철도 통신·신호·처리 시스템 소프트웨어의 유럽 표준. 소프트웨어 SIL 0~4를 정한다. 2023년에 후속 표준 EN 50716이 나왔다.", "links": [], "tags": ["철도", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iec-62304", "term": "IEC 62304", "aliases": ["IEC62304", "의료기기 소프트웨어 표준"], "definition": "의료기기 소프트웨어 생명주기 국제 표준. 위해 가능성에 따라 소프트웨어 안전 등급 A·B·C를 정하고 등급별 활동을 요구한다.", "links": [], "tags": ["의료", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "mil-std-498", "term": "MIL-STD-498", "aliases": ["MIL STD 498"], "definition": "1994년에 나온 미국 국방부의 소프트웨어 개발·문서화 표준. 1998년에 폐지되고 J-STD-016과 IEEE/EIA 12207이 뒤를 이었지만, SDP·SRS·SDD·STD 같은 산출물 체계는 지금도 국방 소프트웨어 사업에서 참고로 널리 쓰인다.", "links": [], "tags": ["국방", "문서", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "tool-qualification", "term": "도구 자격 인증", "aliases": ["Tool Qualification", "TCL", "TQL", "도구 신뢰성 확인"], "definition": "개발·검증에 쓰는 소프트웨어 도구의 결과를 믿을 수 있음을 보이는 활동. ISO 26262는 도구 신뢰 수준(TCL), DO-178C·DO-330은 도구 자격 수준(TQL)으로 정한다.", "links": [], "tags": ["기능안전", "항공"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "aspice", "term": "ASPICE", "aliases": ["Automotive SPICE", "A-SPICE", "오토모티브 스파이스"], "definition": "자동차 소프트웨어·시스템 개발 프로세스를 평가하는 모델. 프로세스마다 능력 수준 0~5를 평가하며, 완성차 업체가 협력사에 수준 2나 3을 요구하곤 한다.", "links": [], "tags": ["프로세스", "자동차"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "cmmi", "term": "CMMI", "aliases": ["Capability Maturity Model Integration", "능력 성숙도 모델"], "definition": "조직의 개발 프로세스 성숙도를 1~5단계로 평가하고 개선하는 모델.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "v-model", "term": "V 모델", "aliases": ["V-Model", "V모델", "V-모델"], "definition": "개발 단계(요구사항→설계→구현)와 검증 단계(단위→통합→시스템 시험)를 V자로 짝지은 개발 모델. 단계마다 짝이 되는 시험이 있다.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "verification", "term": "검증", "aliases": ["Verification", "베리피케이션"], "definition": "제품을 올바르게 만들었는지 확인하는 것. 각 단계 산출물이 앞 단계의 요구사항을 지키는지 검토·분석·시험으로 본다.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "validation", "term": "타당성 확인", "aliases": ["Validation", "밸리데이션"], "definition": "올바른 제품을 만들었는지 확인하는 것. 완성된 제품이 사용자의 실제 요구와 사용 환경에 맞는지 본다.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "iv-and-v", "term": "IV&V", "aliases": ["Independent Verification and Validation", "독립 검증 및 확인", "제3자 검증"], "definition": "개발 조직과 독립된 조직이 하는 검증과 확인. 개발자가 놓치기 쉬운 결함을 객관적으로 찾는다.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "traceability", "term": "추적성", "aliases": ["Traceability", "요구사항 추적성", "RTM", "추적 매트릭스"], "definition": "요구사항과 설계, 코드, 시험을 서로 연결해 각 요구사항이 구현되고 검증됐는지 양방향으로 따라갈 수 있게 하는 것. 안전 규격이 공통으로 요구한다.", "links": [], "tags": ["프로세스", "문서"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "srs", "term": "SRS", "aliases": ["Software Requirements Specification", "소프트웨어 요구사항 명세서", "요구사항 명세서"], "definition": "소프트웨어가 해야 할 기능, 성능, 인터페이스, 제약을 정리한 문서. 시험 케이스는 SRS의 요구사항 ID에 연결한다.", "links": [], "tags": ["문서"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sdd", "term": "SDD", "aliases": ["Software Design Description", "소프트웨어 설계 기술서"], "definition": "소프트웨어의 구조와 모듈, 인터페이스, 자료 설계를 기술한 문서.", "links": [], "tags": ["문서"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "std", "term": "STD", "aliases": ["Software Test Description", "소프트웨어 시험 기술서", "시험 절차서"], "definition": "시험 케이스와 절차, 기대 결과를 기술한 문서. 국방 사업 산출물 체계에서 쓰는 이름이다.", "links": [], "tags": ["문서", "시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "str", "term": "STR", "aliases": ["Software Test Report", "소프트웨어 시험 보고서", "시험 결과서"], "definition": "시험을 수행한 결과와 찾은 결함, 판정을 정리한 문서.", "links": [], "tags": ["문서", "시험"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "code-review", "term": "코드 리뷰", "aliases": ["Code Review", "코드 검토", "동료 검토", "Peer Review"], "definition": "작성자가 아닌 사람이 코드를 읽고 결함, 규칙 위반, 개선점을 찾는 활동. 정적분석 도구로 찾기 어려운 설계 문제를 잡는다.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "inspection", "term": "인스펙션", "aliases": ["Inspection", "정형 검토", "Fagan Inspection"], "definition": "역할(진행자, 작성자, 검토자)과 절차, 점검표를 정해 산출물을 체계적으로 검토하는 정형 검토 방식.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "ci", "term": "CI", "aliases": ["Continuous Integration", "지속적 통합"], "definition": "개발자들이 코드를 자주 합치고, 합칠 때마다 빌드와 시험(정적분석 포함)을 자동으로 돌려 문제를 일찍 찾는 방식.", "links": [], "tags": ["프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "error-fault-failure", "term": "오류·결함·고장", "aliases": ["에러·폴트·페일러"], "definition": "사람의 실수(오류)가 코드나 문서에 결함을 남기고, 그 결함이 실행되면 시스템이 요구된 기능을 못 하는 고장으로 나타난다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "defect", "term": "결함", "aliases": ["Defect", "버그", "Bug"], "definition": "요구사항이나 기대와 다르게 동작하게 만드는 코드나 문서의 잘못. 재현 절차, 기대 결과, 실제 결과를 적어 보고한다.", "links": [], "tags": ["결함"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "root-cause-analysis", "term": "근본 원인 분석", "aliases": ["Root Cause Analysis", "RCA", "원인 분석"], "definition": "결함이나 사고가 왜 생겼는지 겉으로 드러난 원인 너머의 근본 원인을 찾아, 다시 생기지 않도록 대책을 세우는 활동.", "links": [], "tags": ["결함", "프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "sbom", "term": "SBOM", "aliases": ["Software Bill of Materials", "소프트웨어 자재 명세서"], "definition": "소프트웨어에 들어간 구성 요소(오픈소스, 라이브러리)와 버전, 라이선스를 정리한 목록. 취약점이 알려졌을 때 영향 받는 제품을 빨리 찾게 한다.", "links": [], "tags": ["보안", "오픈소스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "gpl", "term": "GPL", "aliases": ["GNU General Public License", "GNU GPL"], "definition": "자유 소프트웨어 재단의 오픈소스 라이선스. GPL 코드를 고치거나 포함한 프로그램을 배포하면 그 소스 코드도 GPL로 공개해야 하는 카피레프트 조건이 있다.", "links": [], "tags": ["오픈소스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "embedded-software", "term": "임베디드 소프트웨어", "aliases": ["Embedded Software", "펌웨어", "Firmware"], "definition": "자동차 제어기, 가전, 무기 체계처럼 특정 기기 안에 들어가 그 기기를 제어하는 소프트웨어. 메모리와 실행 시간 제약이 크다.", "links": [], "tags": ["임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "ecu", "term": "ECU", "aliases": ["Electronic Control Unit", "전자 제어 장치", "제어기"], "definition": "차량의 엔진, 브레이크, 조향 등을 제어하는 전자 장치. 요즘 차량에는 수십 개에서 백여 개가 들어간다.", "links": [], "tags": ["자동차", "임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "autosar", "term": "AUTOSAR", "aliases": ["오토사"], "definition": "자동차 전자 제어 장치 소프트웨어의 표준 아키텍처와 인터페이스. 기존 제어기용 Classic Platform과 고성능 컴퓨터용 Adaptive Platform이 있다.", "links": [], "tags": ["자동차", "표준"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "rtos", "term": "RTOS", "aliases": ["Real-Time Operating System", "실시간 운영체제"], "definition": "작업이 정해진 시간 안에 끝나도록 예측할 수 있는 스케줄링을 제공하는 운영체제. 자동차에서는 OSEK·AUTOSAR OS 계열이 쓰인다.", "links": [], "tags": ["임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "watchdog", "term": "워치독", "aliases": ["Watchdog", "워치독 타이머", "WDT"], "definition": "소프트웨어가 정해진 시간 안에 신호를 주지 않으면 시스템을 다시 시작하거나 안전한 상태로 바꾸는 타이머. 프로그램이 멈춘 것을 찾는 안전 메커니즘이다.", "links": [], "tags": ["임베디드", "기능안전"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "model-based-design", "term": "모델 기반 개발", "aliases": ["Model-Based Design", "MBD", "모델 기반 설계"], "definition": "제어 알고리즘을 Simulink 같은 모델로 설계하고 시뮬레이션으로 검증한 뒤 코드를 자동으로 생성하는 개발 방식.", "links": [], "tags": ["자동차", "프로세스"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "can", "term": "CAN", "aliases": ["Controller Area Network", "CAN 통신"], "definition": "차량 안 제어기들이 서로 데이터를 주고받는 직렬 통신 방식. 메시지마다 우선순위가 있고 잡음에 강하다.", "links": [], "tags": ["자동차", "임베디드"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "llm", "term": "LLM", "aliases": ["Large Language Model", "대규모 언어 모델", "거대 언어 모델"], "definition": "많은 글을 학습해 글을 이해하고 만들어 내는 AI 모델. Claude, ChatGPT, Gemini 같은 서비스의 바탕이다.", "links": [], "tags": ["AI"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "prompt", "term": "프롬프트", "aliases": ["Prompt", "지시문"], "definition": "AI에게 하는 요청 글. 맡길 일, 입력 자료, 지켜야 할 규칙, 원하는 출력 형식을 분명히 쓸수록 결과가 좋아진다.", "links": [], "tags": ["AI"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "hallucination", "term": "할루시네이션", "aliases": ["Hallucination", "환각", "AI 환각"], "definition": "AI가 사실이 아닌 내용을 그럴듯하게 지어내는 현상. 규격 조항 번호나 수치처럼 확인할 수 있는 내용은 원문과 대조해야 한다.", "links": [], "tags": ["AI"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "pseudonymization", "term": "가명처리", "aliases": ["가명 처리", "Pseudonymization", "가명화"], "definition": "정보의 일부를 지우거나 바꿔, 추가 정보 없이는 누구인지 알아볼 수 없게 처리하는 것. Sure-Mate는 고객사명·IP·경로를 CLIENT_A 같은 가명으로 바꿔 AI에 보내고, 답을 받은 뒤 원래 이름으로 되돌린다.", "links": [], "tags": ["AI", "개인정보"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 },
    { "id": "personal-information", "term": "개인정보", "aliases": ["Personal Information", "개인 정보", "PII"], "definition": "살아 있는 개인을 알아볼 수 있는 정보. 이름, 연락처뿐 아니라 다른 정보와 쉽게 결합해 알아볼 수 있는 정보도 들어간다. 외부 AI에 넣기 전에 빼거나 가명 처리한다.", "links": [], "tags": ["개인정보"], "source": "builtin", "updatedAt": "2026-11-09T00:00:00.000Z", "version": 1 }
  ]
}
